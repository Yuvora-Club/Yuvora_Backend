# Copy to .env and fill from Firebase Console > Project settings > Service accounts
# (Generate new private key). NEVER commit .env.

PORT=4000
# Comma-separated list of allowed browser origins (CORS). Must include the
# live domain or https://yuvora.org fetches fail preflight with
# "No 'Access-Control-Allow-Origin' header". Set the SAME value on Render:
# dashboard > service > Environment > FRONTEND_URL, then redeploy.
FRONTEND_URL=https://yuvora.org,https://www.yuvora.org,http://localhost:5173

FIREBASE_PROJECT_ID=yuvora-submission
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@yuvora-submission.iam.gserviceaccount.com
# Private key with \n escaped on one line (as it comes in the JSON key file):
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# From your message — Realtime Database in asia-southeast1:
FIREBASE_DATABASE_URL=https://yuvora-submission-default-rtdb.asia-southeast1.firebasedatabase.app/
FIRESTORE_EMULATOR_HOST=
# Web API Key for password login + reset emails (POST /api/auth/login, /api/auth/reset).
# Firebase Console > Project settings > General > Your apps > Web API Key.
# Also add it on Render (dashboard > service > Environment). NOT the private key.
FIREBASE_WEB_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---------- team entry-fee payments (manual UPI) ----------
# Payments page + UPI link come alive ONLY when UPI_ID is a real UPI id.
# While it stays PLACEHOLDER_UPI_ID the payment page shows "Payments opening
# soon" and no UPI link/QR is rendered. Setting a real value needs NO code.
UPI_ID=PLACEHOLDER_UPI_ID
PAYEE_NAME=Yuvora
# Fallback team fee (used only when the event has no entryFee/sportFees set).
ENTRY_FEE_PER_TEAM=1500
# team | player — how the ENV fallback fee is interpreted (player needs FEE_PER_PLAYER).
FEE_MODE=team
FEE_PER_PLAYER=0
# Global cap of teams per event (0 = no cap). Per-event maxTeams overrides it.
MAX_TEAMS=15
# Pending orders auto-expire after this many hours (frees the slot + paise).
ORDER_EXPIRY_HOURS=24
# Editable refund rule shown on the payment page.
REFUND_NOTE=No refunds after the registration deadline.

# Password for the standalone payments dashboard (separate from Firebase admin).
# SIMPLE: set a plaintext password here + on Render (PAY_ADMIN_PASSWORD).
# The backend reads it directly from env — no hashing step needed.
# (Advanced: ADMIN_PASSWORD_HASH scrypt hash via `npm run pay:pass` still works
# as a fallback. NEVER commit a real one.)
PAY_ADMIN_PASSWORD=PLACEHOLDER_PAY_ADMIN_PASSWORD
ADMIN_PASSWORD_HASH=PLACEHOLDER_ADMIN_HASH
# Optional extra secret for signing the pay-admin session token. If empty it is
# derived from ADMIN_PASSWORD_HASH. Set a long random value in production.
PAY_ADMIN_SECRET=

# Cloudflare Turnstile — guards the "create payment order" endpoint. Leave as
# placeholders in dev: verification is skipped while CAPTCHA_SECRET starts with
# PLACEHOLDER, and the widget is hidden while CAPTCHA_SITE_KEY is a placeholder.
CAPTCHA_SITE_KEY=PLACEHOLDER_TURNSTILE_SITE_KEY
CAPTCHA_SECRET=PLACEHOLDER_TURNSTILE_SECRET
